@inherits LayoutComponentBase
@implements IDisposable

@using eSanta.Components.Shoutbox

@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="snowfall" aria-hidden="true">
    @foreach (var style in _snowflakeStyles)
    {
        <span class="snowflake" style="@style">❄</span>
    }
</div>

<MudLayout>
    <MudAppBar Elevation="2" Class="festive-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Przełącz menu"
                       OnClick="ToggleDrawer" />
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="ml-2 festive-brand">
            <MudIcon Icon="@Icons.Material.Filled.Park" Class="festive-brand-icon" />
            <span class="festive-title">Aplikacja wigilijna</span>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                @if (ShowSideShoutbox)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Forum"
                                   Color="Color.Inherit"
                                   Edge="Edge.End"
                                   aria-label="Przełącz czat Pogadajmy"
                                   OnClick="ToggleShoutbox" />
                }
            </Authorized>
            <NotAuthorized>
                <MudButton Href="Account/Login" Color="Color.Inherit" Variant="Variant.Text">Zaloguj się</MudButton>
                <MudButton Href="Account/Register" Color="Color.Inherit" Variant="Variant.Outlined" Class="ml-2">Zarejestruj się</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Elevation="2">
        <NavMenu />
    </MudDrawer>

    @* The shoutbox needs an interactive circuit, so it is hidden on statically rendered pages (e.g. account management)
       and on the chat page, which shows it full screen. *@
    <AuthorizeView>
        <Authorized>
            @if (ShowSideShoutbox)
            {
                <MudDrawer @bind-Open="_shoutboxOpen"
                           Anchor="Anchor.End"
                           Variant="DrawerVariant.Responsive"
                           ClipMode="DrawerClipMode.Always"
                           Width="320px"
                           Elevation="2">
                    <ShoutboxPanel />
                </MudDrawer>
            }
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 festive-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const int SnowflakeCount = 18;

    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#B71C1C",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#1B5E20",
            SecondaryContrastText = "#FFFFFF",
            Tertiary = "#C9A227",
            TertiaryContrastText = "#3E2723",
            Error = "#D32F2F",
            Background = "#FBF6EE",
            Surface = "#FFFFFF",
            AppbarBackground = "#8E1616",
            AppbarText = "#FFF8E7",
            DrawerBackground = "#FFFCF6",
            DrawerText = "#3E2723",
            DrawerIcon = "#1B5E20",
            TextPrimary = "#3E2723",
            TableHover = "#FDF1E3",
            Divider = "#E8DCCB"
        }
    };

    private static readonly string[] _snowflakeStyles = Enumerable.Range(0, SnowflakeCount)
        .Select(index => FormattableString.Invariant(
            $"--left:{index * 37 % 100}%;--size:{0.6 + index % 4 * 0.3:0.0}rem;--duration:{9 + index % 5 * 3}s;--delay:{-(index * 1.7):0.0}s;--drift:{(index % 2 == 0 ? 30 : -30)}px"))
        .ToArray();

    private bool _drawerOpen = true;

    private bool _shoutboxOpen = true;
    private bool _isChatPage;

    private bool ShowSideShoutbox => RendererInfo.IsInteractive && !_isChatPage;

    protected override void OnInitialized()
    {
        _isChatPage = IsChatPage(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var isChatPage = IsChatPage(e.Location);
        if (isChatPage != _isChatPage)
        {
            _isChatPage = isChatPage;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsChatPage(string uri)
    {
        var path = NavigationManager.ToBaseRelativePath(uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, Pages.Chat.Route, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleShoutbox() => _shoutboxOpen = !_shoutboxOpen;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
