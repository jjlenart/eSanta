@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using eSanta.Data
@using eSanta.Features.Account

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAliasService AliasService
@inject IdentityRedirectManager RedirectManager

<PageTitle>Profil</PageTitle>

<h3>Profil</h3>
<StatusMessage Message="@message" />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="alias" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@userName" id="userName" class="form-control" placeholder="Login" disabled />
                <label for="userName" class="form-label">Login</label>
            </div>
            <div class="form-floating mb-1">
                <InputText @bind-Value="Input.Alias" id="Input.Alias" class="form-control" aria-required="true" aria-describedby="alias-help" placeholder="Alias" maxlength="@ApplicationUser.DisplayNameMaxLength" />
                <label for="Input.Alias" class="form-label">Alias</label>
            </div>
            <div id="alias-help" class="form-text mb-3">Pod tą nazwą widzą Cię inni użytkownicy aplikacji.</div>
            <ValidationMessage For="() => Input.Alias" class="text-danger" />
            <button type="submit" class="w-100 btn btn-lg btn-primary">Zapisz</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private string? userName;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private AliasModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        userName = user.UserName;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input.Alias = user.Alias;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var result = await AliasService.ChangeAliasAsync(user, Input);
        if (!result.Succeeded)
        {
            message = $"Błąd: {result.Error}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Alias został zmieniony.", HttpContext);
    }
}
