@page "/shopping-list"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using eSanta.Common
@using eSanta.Components.Shopping
@using eSanta.Features.ShoppingList

@attribute [Authorize]

@inject IShoppingListService ShoppingListService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Moja lista zakupowa</PageTitle>

<MudStack Row="true"
          Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center"
          Wrap="Wrap.Wrap"
          Class="mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1">Moja lista zakupowa</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenAddCustomDialogAsync"
               Disabled="_ownerId is null">
        Dodaj osobę spoza listy
    </MudButton>
</MudStack>
<MudText Typo="Typo.body2" Class="mb-4">Ta lista jest widoczna tylko dla Ciebie. Prezenty zarezerwowane na listach innych osób pojawiają się tu automatycznie.</MudText>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
}

@if (_rows is null && _loadError is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_rows is not null)
{
    <MudTable Items="_rows"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="1">
        <HeaderContent>
            <MudTh>Osoba</MudTh>
            <MudTh>Nazwa prezentu</MudTh>
            <MudTh Style="text-align:center">Zarezerwowane</MudTh>
            <MudTh Style="text-align:center">Kupione</MudTh>
            <MudTh>Notatka</MudTh>
            <MudTh Style="text-align:right">Akcje</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Osoba">
                <strong>@context.RecipientName</strong>
                @if (context.Recipient.IsCustom)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">spoza listy</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Nazwa prezentu">
                @if (context.GiftName is not null)
                {
                    @context.GiftName
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Zarezerwowane" Style="text-align:center">
                @if (context.IsReserved)
                {
                    <MudTooltip Text="Zarezerwowane na liście tej osoby">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" aria-label="Zarezerwowane" />
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Kupione" Style="text-align:center">
                <MudCheckBox T="bool"
                             Value="context.IsBought"
                             ValueChanged="@(value => SetBoughtAsync(context, value))"
                             Color="Color.Primary"
                             aria-label="@($"Kupione: {context.RecipientName}")" />
            </MudTd>
            <MudTd DataLabel="Notatka" Style="white-space:pre-line">@context.Note</MudTd>
            <MudTd DataLabel="Akcje" Style="text-align:right; white-space:nowrap">
                <MudTooltip Text="Edytuj">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   aria-label="@($"Edytuj wpis dla {context.RecipientName}")"
                                   OnClick="@(() => OpenEditDialogAsync(context))" />
                </MudTooltip>
                @if (context.Recipient.IsCustom)
                {
                    <MudTooltip Text="Usuń">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="@($"Usuń wpis dla {context.RecipientName}")"
                                       OnClick="@(() => DeleteAsync(context))" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Na liście obecności nie ma jeszcze innych osób. Możesz dodać osobę spoza listy.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private static readonly DialogOptions FormDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string? _ownerId;
    private IReadOnlyList<ShoppingListRowDto>? _rows;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        _ownerId = (await AuthenticationState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (_ownerId is null)
        {
            _loadError = "Nie udało się ustalić zalogowanego użytkownika. Zaloguj się ponownie.";
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _rows = await ShoppingListService.GetAsync(_ownerId!);
            _loadError = null;
        }
        catch (Exception)
        {
            _loadError = "Nie udało się wczytać listy zakupowej. Odśwież stronę.";
        }
    }

    private async Task OpenAddCustomDialogAsync()
    {
        var parameters = new DialogParameters<ShoppingEntryDialog>
        {
            { dialog => dialog.Model, new ShoppingEntryFormModel() },
            { dialog => dialog.IsCustomRecipient, true },
            { dialog => dialog.OnSave, model => ShoppingListService.AddCustomAsync(_ownerId!, model) }
        };

        await ShowDialogAsync("Prezent dla osoby spoza listy", parameters, "Dodano wpis.");
    }

    private async Task OpenEditDialogAsync(ShoppingListRowDto row)
    {
        var parameters = new DialogParameters<ShoppingEntryDialog>
        {
            { dialog => dialog.Model, ShoppingEntryFormModel.FromRow(row) },
            { dialog => dialog.IsCustomRecipient, row.Recipient.IsCustom },
            { dialog => dialog.ReservedGiftNames, row.ReservedGiftNames },
            { dialog => dialog.OnSave, model => ShoppingListService.SaveAsync(_ownerId!, row.Recipient, model) }
        };

        await ShowDialogAsync($"Prezent dla: {row.RecipientName}", parameters, "Zapisano zmiany.");
    }

    private async Task ShowDialogAsync(string title, DialogParameters<ShoppingEntryDialog> parameters, string successMessage)
    {
        var dialog = await DialogService.ShowAsync<ShoppingEntryDialog>(title, parameters, FormDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add(successMessage, Severity.Success);
            await LoadAsync();
        }
    }

    private async Task SetBoughtAsync(ShoppingListRowDto row, bool isBought)
    {
        var model = ShoppingEntryFormModel.FromRow(row);
        model.IsBought = isBought;

        await ExecuteAsync(() => ShoppingListService.SaveAsync(_ownerId!, row.Recipient, model), successMessage: null);
    }

    private async Task DeleteAsync(ShoppingListRowDto row)
    {
        if (row.Recipient.CustomEntryId is not { } entryId)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Usuń wpis",
            $"Czy na pewno chcesz usunąć wpis dla „{row.RecipientName}”?",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirmed != true)
        {
            return;
        }

        await ExecuteAsync(() => ShoppingListService.DeleteCustomAsync(_ownerId!, entryId), "Usunięto wpis.");
    }

    private async Task ExecuteAsync(Func<Task<ServiceResult>> operation, string? successMessage)
    {
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                if (successMessage is not null)
                {
                    Snackbar.Add(successMessage, Severity.Success);
                }
            }
            else
            {
                Snackbar.Add(result.Error ?? "Operacja nie powiodła się.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Nie udało się zapisać zmian. Spróbuj ponownie.", Severity.Error);
        }

        await LoadAsync();
    }
}
