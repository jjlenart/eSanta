@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd</PageTitle>

<h1 class="text-danger">Błąd.</h1>
<h2 class="text-danger">Podczas przetwarzania żądania wystąpił błąd.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID żądania:</strong> <code>@RequestId</code>
    </p>
}

<h3>Tryb deweloperski</h3>
<p>
    Po przełączeniu na środowisko <strong>Development</strong> zobaczysz więcej szczegółów o błędzie.
</p>
<p>
    <strong>Nie włączaj środowiska Development we wdrożonej aplikacji.</strong>
    Może to ujawnić użytkownikom poufne informacje z wyjątków.
    Do lokalnego debugowania ustaw zmienną środowiskową <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    i uruchom aplikację ponownie.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
