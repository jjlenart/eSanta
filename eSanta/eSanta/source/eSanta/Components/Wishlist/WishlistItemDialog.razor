@using eSanta.Data
@using eSanta.Features.Wishlist

@inherits FormDialogBase<WishlistItemFormModel>

<FormDialogLayout Model="Model" Error="@Error" IsSaving="IsSaving" OnValidSubmit="SubmitAsync" OnCancel="Cancel">
    <MudTextField @bind-Value="Model.Name"
                  For="@(() => Model.Name)"
                  Label="Nazwa"
                  Variant="Variant.Outlined"
                  MaxLength="WishlistItem.NameMaxLength"
                  Immediate="true"
                  AutoFocus="true" />
    <MudTextField @bind-Value="Model.Description"
                  For="@(() => Model.Description)"
                  Label="Opis (opcjonalnie)"
                  Variant="Variant.Outlined"
                  MaxLength="WishlistItem.DescriptionMaxLength"
                  Lines="4"
                  Sizing="InputSizing.Auto"
                  Immediate="true" />
    <MudTextField @bind-Value="Model.Link"
                  For="@(() => Model.Link)"
                  Label="Link (opcjonalnie)"
                  Placeholder="https://"
                  HelperText="Np. strona sklepu, w którym można kupić prezent."
                  InputType="InputType.Url"
                  Variant="Variant.Outlined"
                  MaxLength="WishlistItem.LinkMaxLength"
                  Immediate="true" />
</FormDialogLayout>

@code {
    protected override string UnexpectedErrorMessage => "Nie udało się zapisać prezentu. Spróbuj ponownie.";
}
