@using eSanta.Features.Administration

@inherits FormDialogBase<SetPasswordModel>

<FormDialogLayout Model="Model" Error="@Error" IsSaving="IsSaving" OnValidSubmit="SubmitAsync" OnCancel="Cancel" SubmitText="Ustaw hasło">
    <MudText Typo="Typo.body2">
        Po zmianie hasła użytkownik zostanie wylogowany na innych urządzeniach. Przekaż mu nowe hasło osobiście.
    </MudText>

    <MudTextField @bind-Value="Model.NewPassword"
                  For="@(() => Model.NewPassword)"
                  Label="Nowe hasło"
                  InputType="InputType.Password"
                  Variant="Variant.Outlined"
                  autocomplete="new-password"
                  Immediate="true"
                  AutoFocus="true" />

    <MudTextField @bind-Value="Model.ConfirmPassword"
                  For="@(() => Model.ConfirmPassword)"
                  Label="Powtórz hasło"
                  InputType="InputType.Password"
                  Variant="Variant.Outlined"
                  autocomplete="new-password"
                  Immediate="true" />
</FormDialogLayout>

@code {
    protected override string UnexpectedErrorMessage => "Nie udało się ustawić hasła. Spróbuj ponownie.";
}
